<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.agora.challenge</groupId>
        <artifactId>notifications-parent</artifactId>
        <version>2.0.0</version>
    </parent>
    <artifactId>notifications-examples</artifactId>
    <packaging>jar</packaging>

    <dependencies>

        <dependency>
            <groupId>com.agora.challenge</groupId>
            <artifactId>notifications-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.agora.challenge</groupId>
            <artifactId>notifications-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.agora.challenge</groupId>
            <artifactId>notifications-channel-email</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.agora.challenge</groupId>
            <artifactId>notifications-channel-sms</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.agora.challenge</groupId>
            <artifactId>notifications-channel-push</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.agora.challenge</groupId>
            <artifactId>notifications-provider-sendgrid</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.agora.challenge</groupId>
            <artifactId>notifications-provider-mailgun</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.agora.challenge</groupId>
            <artifactId>notifications-provider-twilio</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.agora.challenge</groupId>
            <artifactId>notifications-provider-nexmo</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.agora.challenge</groupId>
            <artifactId>notifications-provider-fcm</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.agora.challenge</groupId>
            <artifactId>notifications-provider-apns</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.agora.challenge</groupId>
            <artifactId>notifications-provider-webpush</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>runtime</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <mainClass>com.agora.notifications.examples.DemoMain</mainClass>
                    <classpathScope>runtime</classpathScope>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
